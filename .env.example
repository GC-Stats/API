DATABASE_URL=
REDIS_URL=
REDIS_LOCAL_URL=

APP_ENV=production

# Production only
ALLOWED_ORIGIN=https://api.gc-stats.app

# Optional (defaults shown)
#BIND_ADDR=0.0.0.0:3000
#DATABASE_MAX_CONNECTIONS=10

# Optional: multi-AZ mode. When set, writes go to DATABASE_URL_WRITE while
# DATABASE_URL is used for reads. Omit to use a single DB for both.
#DATABASE_URL_WRITE=

# Internal service-to-service auth (HMAC, shared with Laravel/DiscordBot —
# same X-Internal-Signature/X-Internal-Timestamp scheme). Guards /internal/*.
INTERNAL_API_SECRET=
# TEMP/testing only: skips the timestamp-skew check (signature is still
# verified). Remove this var / never set it in production.
#INTERNAL_AUTH_SKIP_TIMESTAMP_CHECK=true

# Cube.dev (self-hosted Cube Core, REST API)
CUBE_API_URL=http://cube:4000
#CUBE_API_SECRET=
#CUBE_SCHEMA_CACHE_TTL_SECS=3600
# Comma-separated Cube view names (not raw cubes) whose /meta the LLM prompt
# is built from — keeps ambiguous raw-cube measures out of the model's reach.
#CUBE_VIEW_NAMES=kill_stats,player_stats,player_advanced_stats,damage_stats,round_results,map_results,match_results,round_state_stats,player_positions,tournament_info,tournament_phases_info,tournament_participants,roster,match_schedule,match_vetos_info,point_entries_info

# /internal/nl-query: natural-language -> Cube query
# Provider used when the caller passes llm_provider="platform" (server-held key, never a user's).
PLATFORM_LLM_PROVIDER=openai
PLATFORM_LLM_API_KEY=
#OPENAI_MODEL=gpt-4o-mini
#ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Total time budget (LLM + Cube) before returning a timeout error. Keep below
# Laravel's own HTTP timeout (15-20s) so it gets a clean error, not a cut connection.
#NL_QUERY_TIMEOUT_MS=12000