  "query": "\n        SELECT\n            t.id as team_id,\n            t.name as team_name,\n            t.short_name as team_short,\n            t.country_code as team_country,\n            pt.role,\n            pt.joined_at,\n            pt.left_at\n        FROM player_team pt\n        JOIN teams t ON pt.team_id = t.id\n        WHERE pt.player_id = ?\n        ORDER BY pt.joined_at DESC\n        ",
